<?xml version="1.0" encoding="UTF-8"?>
<!--
  Micro-benchmarks com o JMH (Fase 3). Ver docs/adr/0023.

  Micro-benchmark: medir um pedaço pequeno de código (somar valores, incrementar um contador),
  milhões de vezes. Parece fácil, mas a JVM engana quem mede com um laço e System.nanoTime(): o JIT
  apaga cálculo cujo resultado ninguém usa, o código acelera depois de aquecer... O JMH (Java
  Microbenchmark Harness, do próprio time do OpenJDK) cuida disso: aquece, repete, roda numa JVM
  separada e entrega a média com a margem de erro.

  Não roda no "./mvnw verify". Uso:
    ./mvnw -q -pl desempenho/jmh -am package -DskipTests
    java -jar desempenho/jmh/target/benchmarks.jar            (todos; ~10 min)
    java -jar desempenho/jmh/target/benchmarks.jar Contador   (só os que têm "Contador" no nome)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.alanjoffre.ledgerly</groupId>
        <artifactId>ledgerly-bank</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jmh</artifactId>
    <name>Ledgerly Bank :: Micro-benchmarks (JMH)</name>

    <properties>
        <jmh.version>1.37</jmh.version>
        <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>
        <!-- Medição, não produção: não há o que medir de cobertura. -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- O JMH gera código na compilação (um "processador de anotações"). -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Shade: junta o código e as bibliotecas num jar só, que roda com java -jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
