<?xml version="1.0" encoding="UTF-8"?>
<!--
  Serviço razao: o razão contábil do Ledgerly Bank (Spring Boot).

  Guarda cada movimento de dinheiro como um lançamento em partidas dobradas e
  mantém o saldo das contas. É o ponto mais disputado do sistema: aqui ficam o
  controle de concorrência e a idempotência (ver docs/adr/0008 a 0010).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.alanjoffre.ledgerly</groupId>
        <artifactId>ledgerly-bank</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>razao</artifactId>
    <name>Ledgerly Bank :: Serviço razão</name>

    <!--
      O POM pai já é o do Ledgerly, então o Spring Boot entra como BOM importado
      (em vez de ser o "parent", como no projeto gerado pelo Spring Initializr).
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.alanjoffre.ledgerly</groupId>
            <artifactId>nucleo-compartilhado</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Fase 4: confere o token do Keycloak; todo /v1 exige o papel servico (ADR-0027). -->
        <dependency>
            <groupId>io.github.alanjoffre.ledgerly</groupId>
            <artifactId>seguranca-spring</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- API REST (Spring MVC) e validação dos dados de entrada. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Rastros e métricas por OTLP (ADR-0042). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!-- /actuator/health: o Kubernetes pergunta aqui se o serviço está vivo (Fase 6). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Banco: SQL explícito com JdbcClient, sem JPA (ADR-0008). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Flyway: versiona o esquema do banco em scripts SQL numerados (V1__, V2__...). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Kafka: publica os lançamentos (Outbox) e consome os eventos de conta (ADR-0013, 0014). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- TokensDeTeste: tokens assinados de verdade, com a chave na memória. -->
        <dependency>
            <groupId>io.github.alanjoffre.ledgerly</groupId>
            <artifactId>seguranca-spring</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: sobe um PostgreSQL de verdade (em Docker) durante os testes. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Awaitility: "espere até que..." — para conferir o que acontece de forma assíncrona. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Empacota o serviço num .jar executável: java -jar razao.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Testes de integração (*IT): rodam sobre as classes, não sobre o .jar reempacotado. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
