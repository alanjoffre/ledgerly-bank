<?xml version="1.0" encoding="UTF-8"?>
<!--
  Serviço pix: chaves Pix, QR Code e transferências (Quarkus).

  Orquestra a transferência como uma Saga (ADR-0015): debita o pagador, credita o recebedor e,
  se o crédito for recusado, estorna. Publica PixConcluido e PixEstornado pelo Outbox (ADR-0013).

  Por que Quarkus e não Spring, como os outros: ver ADR-0017 (com a medição de tempo de subida e
  memória dos dois).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.alanjoffre.ledgerly</groupId>
        <artifactId>ledgerly-bank</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pix</artifactId>
    <name>Ledgerly Bank :: Serviço pix</name>

    <properties>
        <quarkus.version>3.40.1</quarkus.version>
        <zxing.version>3.5.4</zxing.version>
        <osgi-annotation.version>8.1.0</osgi-annotation.version>
    </properties>

    <!-- O Quarkus entra como BOM importado, do mesmo jeito que o Spring Boot nos outros serviços. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.alanjoffre.ledgerly</groupId>
            <artifactId>nucleo-compartilhado</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- API REST (JAX-RS / Jakarta REST) com JSON, e validação dos dados de entrada. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <!-- Clientes HTTP declarativos para o razão e o serviço de contas. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>

        <!-- Banco: SQL explícito sobre JDBC (pool Agroal + transações JTA), como o razão (ADR-0008). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway-postgresql</artifactId>
        </dependency>

        <!-- Redis: a camada rápida contra pedido repetido, antes do banco (ADR-0018). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-redis-client</artifactId>
        </dependency>
        <!-- Kafka: o publicador do Outbox manda PixConcluido e PixEstornado. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-messaging-kafka</artifactId>
        </dependency>
        <!-- Tarefas agendadas: retomada das Sagas paradas e faxina do Outbox. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!-- Circuit breaker na chamada ao antifraude (ADR-0041). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>

        <!-- Rastros e métricas por OTLP; as métricas do Micrometer vão pelo mesmo caminho (ADR-0042). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-opentelemetry</artifactId>
        </dependency>

        <!-- /q/health: o Kubernetes pergunta aqui se o serviço está vivo (Fase 6). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!--
          Segurança (ADR-0025): quarkus-oidc confere o token de quem chama (o Pix como "resource
          server"); quarkus-oidc-client busca no Keycloak o token do próprio Pix (client
          credentials), e o filtro o põe em cada chamada ao razão e a contas.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-oidc-filter</artifactId>
        </dependency>

        <!-- ZXing: monta a matriz do QR Code (só o núcleo, sem AWT — funciona na imagem nativa). -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!--
          Só para compilar: uma biblioteca do Kafka usa anotações OSGi, e sem elas no classpath o
          compilador avisa — e aqui todo aviso vira erro (-Werror). Não vai para o pacote final.
        -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.annotation</artifactId>
            <version>${osgi-annotation.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Cobertura dos testes @QuarkusTest. O Quarkus transforma as classes ao carregar, e o agente
          do JaCoCo do jeito comum não as enxerga; esta extensão mede por dentro e grava em
          target/jacoco-quarkus.exec, que entra na soma da cobertura (ver o JaCoCo abaixo).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- O plugin do Quarkus faz, no build, o trabalho que outros frameworks fazem ao subir. -->
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Soma as três medições: unidade, integração e a dos testes @QuarkusTest. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>somar-medicoes</id>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                        <include>jacoco-quarkus.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Os testes @QuarkusTest são de integração (sobem PostgreSQL, Kafka e Redis): nome *IT. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Imagem nativa (GraalVM): ./mvnw -pl servicos/pix -am package -Pnativo -DskipTests
          A compilação roda num contêiner com o GraalVM (Mandrel), sem instalar nada na máquina.
        -->
        <profile>
            <id>nativo</id>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.native.container-build>true</quarkus.native.container-build>
            </properties>
        </profile>
    </profiles>
</project>
