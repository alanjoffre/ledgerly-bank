{
  "consumer": {
    "name": "pix"
  },
  "interactions": [
    {
      "description": "um envio de Pix maior que o saldo",
      "providerStates": [
        {
          "name": "a conta est\u00E1 sem saldo"
        }
      ],
      "request": {
        "body": {
          "contaId": "0a000000-0000-4000-8000-000000000001",
          "descricao": "Pix",
          "valor": "30.00"
        },
        "headers": {
          "Content-Type": "application/json",
          "Idempotency-Key": "contrato-sem-saldo"
        },
        "matchingRules": {
          "body": {
            "$.contaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.descricao": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.valor": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d+\\.\\d{2}$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/v1/pix/envios"
      },
      "response": {
        "body": {
          "detail": "Saldo insuficiente",
          "type": "urn:ledgerly:erro:saldo-insuficiente"
        },
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "matchingRules": {
          "body": {
            "$.detail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 422
      }
    },
    {
      "description": "um envio de Pix",
      "providerStates": [
        {
          "name": "a conta tem saldo"
        }
      ],
      "request": {
