{
  "consumer": {
    "name": "pix"
  },
  "interactions": [
    {
      "description": "o pedido de avalia\u00E7\u00E3o de um Pix de baixo risco",
      "providerStates": [
        {
          "name": "o antifraude est\u00E1 no ar"
        }
      ],
      "request": {
        "body": {
          "contaRecebedoraAbertaEm": "2024-01-10T12:00:00Z",
          "instante": "2026-10-29T17:00:00Z",
          "pagadorContaId": "0a000000-0000-4000-8000-000000000005",
          "recebedorContaId": "0a000000-0000-4000-8000-000000000006",
          "transferenciaId": "0a000000-0000-4000-8000-000000000004",
          "valor": "90.00"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.contaRecebedoraAbertaEm": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.instante": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagadorContaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.recebedorContaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.transferenciaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.valor": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d+\\.\\d{2}$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/v1/avaliacoes"
      },
      "response": {
        "body": {
          "decisao": "APROVAR",
          "nota": 40
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.nota": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.6"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "antifraude"
  }
}
