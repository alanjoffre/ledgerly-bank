<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM pai do Ledgerly Bank.

  O que é: o "pom.xml" é o arquivo de configuração do Maven (a ferramenta que
  compila, testa e empacota projetos Java). Este é o POM *pai*: ele não gera
  nenhum programa; só define o que todos os módulos filhos herdam —
  versão do Java, versões das bibliotecas e regras de qualidade.

  Por que um POM pai: para que cada serviço não escolha sua própria versão de
  JUnit, de compilador etc. Uma versão só, num lugar só (ver docs/adr/0002).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.alanjoffre.ledgerly</groupId>
    <artifactId>ledgerly-bank</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ledgerly Bank</name>
    <description>Banco digital fictício para estudo: razão contábil, Pix, antifraude com IA.</description>
    <url>https://github.com/alanjoffre/ledgerly-bank</url>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <!-- Módulos: cada pasta listada aqui é um projeto Maven filho. -->
    <modules>
        <module>bibliotecas/nucleo-compartilhado</module>
        <!-- Fase 4: conferir o token do Keycloak nos serviços Spring (ADR-0024). -->
        <module>bibliotecas/seguranca-spring</module>
        <module>servicos/razao</module>
        <module>servicos/contas</module>
        <module>servicos/pix</module>
        <module>servicos/extrato</module>
        <module>servicos/gateway</module>
        <!-- Fase 5: o antifraude (modelo ONNX + regras, ADR-0032). -->
        <module>servicos/antifraude</module>
        <!-- Fase 5: o assistente "pergunte ao seu extrato" (RAG + ferramentas só de leitura, ADR-0036). -->
        <module>servicos/assistente</module>
        <!-- Fase 3: medições. Compilam no build; rodam só quando alguém pede (ver cada pom). -->
        <module>desempenho/carga</module>
        <module>desempenho/jmh</module>
        <!-- Fase 3: a conciliação em lote (Java puro, com recursos em preview: só aqui). -->
        <module>lotes/conciliacao</module>
    </modules>

    <properties>
        <!-- Java 25 é a versão LTS (suporte longo) atual. Ver docs/adr/0003. -->
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versões de bibliotecas (uma só para o projeto inteiro). -->
        <!-- Os serviços Spring importam o BOM do Spring Boot; os Quarkus, o do Quarkus (ADR-0002). -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <archunit.version>1.5.1</archunit.version>

        <!-- Versões de plugins (as "ferramentas" que o Maven usa no build). -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <pitest.version>1.30.1</pitest.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <!-- Análise de código (ADR-0046). Sem servidor configurado, nada disso roda. -->
        <sonar.projectKey>alanjoffre_ledgerly-bank</sonar.projectKey>
        <sonar.projectName>Ledgerly Bank</sonar.projectName>
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/**/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <pact.version>4.7.6</pact.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <pitest.threads>4</pitest.threads>

        <!-- Cobertura mínima de testes exigida no build (linhas). -->
        <cobertura.minima>0.90</cobertura.minima>
    </properties>

    <!--
      dependencyManagement: aqui só se DECLARA a versão. Um módulo que quiser
      usar o JUnit escreve só o groupId/artifactId, sem versão — e herda esta.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- BOM ("bill of materials"): uma lista de versões que combinam entre si. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <!-- Testes de contrato entre serviços (ADR-0045): quem chama descreve, quem responde confere. -->
            <dependency>
                <groupId>au.com.dius.pact.consumer</groupId>
                <artifactId>junit5</artifactId>
                <version>${pact.version}</version>
            </dependency>
            <dependency>
                <groupId>au.com.dius.pact.provider</groupId>
                <artifactId>junit5</artifactId>
                <version>${pact.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- -parameters: guarda o nome dos parâmetros (frameworks usam isso). -->
                        <!-- -Xlint:all + -Werror: todo aviso do compilador vira erro. -->
                        <compilerArgs>
                            <arg>-parameters</arg>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- Jar: empacota as bibliotecas (e o test-jar com os tokens de teste do seguranca-spring). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <!-- Surefire roda os testes de unidade (classes *Test). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- Os contratos ficam versionados em contratos/ (ADR-0045). -->
                        <systemPropertyVariables>
                            <pact.rootDir>${maven.multiModuleProjectDirectory}/contratos</pact.rootDir>
                            <pact.writer.overwrite>true</pact.writer.overwrite>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!-- Failsafe roda os testes de integração (classes *IT), com banco de verdade. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <!-- Os contratos ficam versionados em contratos/ (ADR-0045). -->
                        <systemPropertyVariables>
                            <pact.rootDir>${maven.multiModuleProjectDirectory}/contratos</pact.rootDir>
                            <pact.writer.overwrite>true</pact.writer.overwrite>
                        </systemPropertyVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Enforcer: recusa o build se o Java ou o Maven forem antigos demais. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>exigir-versoes</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>O Ledgerly Bank exige Java 25 ou superior (ver docs/guias/ambiente-local.md).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!-- Duas bibliotecas pedindo versões diferentes da mesma dependência = erro. -->
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo mede a cobertura de testes: quantas linhas do código
              foram executadas pelos testes. Abaixo do mínimo, o build falha.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <!-- Agente nos testes de unidade (Surefire) → target/jacoco.exec -->
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Agente nos testes de integração (Failsafe) → target/jacoco-it.exec -->
                    <execution>
                        <id>preparar-agente-integracao</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <!-- Soma as duas medições: a cobertura conta unidade + integração. -->
                    <execution>
                        <id>somar-medicoes</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-total.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>relatorio</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-total.exec</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cobertura-minima</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-total.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.minima}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Com -DskipTests não há testes, então não há o que medir: a cobertura é desligada. -->
        <profile>
            <id>sem-testes</id>
            <activation>
                <property>
                    <name>skipTests</name>
                </property>
            </activation>
            <properties>
                <jacoco.skip>true</jacoco.skip>
            </properties>
        </profile>
        <!--
          Teste de mutação (PIT): muda o código de propósito (troca um > por um >=, tira uma chamada) e
          roda os testes de unidade. Se nenhum teste falhar, o mutante "sobreviveu": a linha é executada,
          mas nada confere o que ela faz. Só o domínio entra, e só os testes de unidade, senão leva
          horas. Fora do build normal; ver ADR-0044.
              ./mvnw -Pmutacao -pl servicos/razao -am test-compile org.pitest:pitest-maven:mutationCoverage
        -->
        <profile>
            <id>mutacao</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.alanjoffre.ledgerly.*.dominio.*</param>
                                <param>io.github.alanjoffre.ledgerly.nucleo.*</param>
                            </targetClasses>
                            <!-- A exceção só carrega o código do erro: quem confere é o teste de integração,
                                 pela resposta da API, e ele não entra nesta conta (ADR-0044). -->
                            <excludedClasses>
                                <param>*Exception</param>
                            </excludedClasses>
                            <!-- Só os testes do domínio: os da biblioteca de segurança vêm no classpath e
                                 não têm o que dizer sobre estas classes. -->
                            <targetTests>
                                <param>io.github.alanjoffre.ledgerly.*.dominio.*</param>
                                <param>io.github.alanjoffre.ledgerly.nucleo.*</param>
                            </targetTests>
                            <threads>${pitest.threads}</threads>
                            <!-- Abaixo disso, o build falha: medido em cada módulo na Fase 7 (ADR-0044). -->
                            <mutationThreshold>90</mutationThreshold>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <format>HTML</format>
                                <format>XML</format>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <skipFailingTests>false</skipFailingTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
